module app.main;

import kata.ui.Screen;
import kata.ui.Text;
import kata.ui.Ui;

class A {
  var count: Int = 0;

  fn label(self) -> Ui {
    return Text { text: self.count };
  }
}

class Main implements Screen {
  fn view(self) -> Ui {
    return Text { text: "" };
  }
}

app {
  id: "dev.kata.test",
  name: "Test",
  root: Main {},
}
