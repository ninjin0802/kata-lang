class A {
  var count: Int = 0;

  fn add(self, a: Int, b: Int) -> Int {
    return a + b;
  }

  fn m(self) -> Unit {
    if (self.count) {
      return;
    }
  }
}

class Main implements Screen {
  fn view(self) -> Ui {
    return Text { text: "" };
  }
}

app {
  id: "dev.kata.test",
